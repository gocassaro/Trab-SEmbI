     1                                  segment data public
     2                                      global desenha_cena
     3                                      global desenha_fundo
     4                                      extern p1_x, p1_y, p1_hp, p1_x_antigo, p1_y_antigo, p1_estado
     5                                      extern p2_x, p2_y, p2_hp, p2_x_antigo, p2_y_antigo, p2_estado
     6                                  
     7                                  segment code
     8                                  
     9                                  ; =========================================================
    10                                  ; DESENHA FUNDO: EXECUTADO APENAS 1 VEZ AO INICIAR O JOGO
    11                                  ; =========================================================
    12                                  desenha_fundo:
    13                                      ; 1. Limpa a tela inteira (Preenche de Preto)
    14 00000000 B80006                      MOV AX, 0600h
    15 00000003 B700                        MOV BH, 00h
    16 00000005 B90000                      MOV CX, 0000h
    17 00000008 BA4F1D                      MOV DX, 1D4Fh
    18 0000000B CD10                        INT 10h
    19                                  
    20                                      ; 2. Desenha o Fundo da Barra P1 (Cinza escuro)
    21 0000000D B91400                      MOV CX, 20          ; X inicial
    22 00000010 BA1400                      MOV DX, 20          ; Y inicial
    23 00000013 BEC800                      MOV SI, 200         ; Largura máxima
    24 00000016 BF0F00                      MOV DI, 15          ; Altura
    25 00000019 B008                        MOV AL, 8           ; Cor: 8 (Cinza)
    26 0000001B E8D900                      CALL desenha_retangulo
    27                                  
    28                                      ; 3. Desenha o Fundo da Barra P2 (Cinza escuro)
    29 0000001E B9A401                      MOV CX, 420         ; X inicial (Termina no 620)
    30 00000021 BA1400                      MOV DX, 20
    31 00000024 BEC800                      MOV SI, 200
    32 00000027 BF0F00                      MOV DI, 15
    33 0000002A B008                        MOV AL, 8
    34 0000002C E8C800                      CALL desenha_retangulo
    35                                      
    36 0000002F C3                          RET
    37                                  
    38                                  ; =========================================================
    39                                  ; DESENHA CENA: EXECUTADO A CADA FRAME (18.2 Hz)
    40                                  ; =========================================================
    41                                  desenha_cena:
    42                                      ; --- 1. APAGA OS RASTROS ---
    43                                      ; Apagar sempre vai varrer o quadrado de 20x20 para garantir que 
    44                                      ; nada do frame anterior sobre na tela, mesmo se voltar de um pulo.
    45 00000030 8B0E[0000]                  MOV CX, [p1_x_antigo]
    46 00000034 8B16[0000]                  MOV DX, [p1_y_antigo]
    47 00000038 BE1400                      MOV SI, 20
    48 0000003B BF1400                      MOV DI, 20
    49 0000003E B000                        MOV AL, 0           
    50 00000040 E8B400                      CALL desenha_retangulo
    51                                  
    52 00000043 8B0E[0000]                  MOV CX, [p2_x_antigo]
    53 00000047 8B16[0000]                  MOV DX, [p2_y_antigo]
    54 0000004B BE1400                      MOV SI, 20
    55 0000004E BF1400                      MOV DI, 20
    56 00000051 B000                        MOV AL, 0
    57 00000053 E8A100                      CALL desenha_retangulo
    58                                  
    59                                      ; --- 2. DESENHA OS LUTADORES NAS POSIÇÕES NOVAS ---
    60                                      ; P1
    61 00000056 8B0E[0000]                  MOV CX, [p1_x]
    62 0000005A 8B16[0000]                  MOV DX, [p1_y]
    63 0000005E BE1400                      MOV SI, 20
    64 00000061 BF1400                      MOV DI, 20          ; Altura padrão
    65 00000064 803E[0000]02                CMP byte [p1_estado], 2 ; Checa se P1 está agachado
    66 00000069 7503                        JNE desenha_p1_cor
    67 0000006B BF0A00                      MOV DI, 10          ; Se sim, altura vira 10
    68                                  desenha_p1_cor:
    69 0000006E B009                        MOV AL, 9           ; Azul
    70 00000070 E88400                      CALL desenha_retangulo
    71                                      
    72                                      ; P2
    73 00000073 8B0E[0000]                  MOV CX, [p2_x]
    74 00000077 8B16[0000]                  MOV DX, [p2_y]
    75 0000007B BE1400                      MOV SI, 20
    76 0000007E BF1400                      MOV DI, 20          ; Altura padrão
    77 00000081 803E[0000]02                CMP byte [p2_estado], 2 ; Checa se P2 está agachado
    78 00000086 7503                        JNE desenha_p2_cor
    79 00000088 BF0A00                      MOV DI, 10          ; Se sim, altura vira 10
    80                                  desenha_p2_cor:
    81 0000008B B004                        MOV AL, 4           ; Vermelho
    82 0000008D E86700                      CALL desenha_retangulo
    83                                  
    84                                      ; --- 3. ATUALIZA AS BARRAS DE VIDA (igual ao seu código anterior) ---
    85 00000090 B91400                      MOV CX, 20
    86 00000093 BA1400                      MOV DX, 20
    87 00000096 BEC800                      MOV SI, 200
    88 00000099 BF0F00                      MOV DI, 15
    89 0000009C B008                        MOV AL, 8           
    90 0000009E E85600                      CALL desenha_retangulo
    91                                      
    92 000000A1 803E[0000]00                CMP byte [p1_hp], 0
    93 000000A6 741A                        JE atualiza_hp2     
    94 000000A8 A0[0000]                    MOV AL, [p1_hp]
    95 000000AB 30E4                        XOR AH, AH          
    96 000000AD BB1400                      MOV BX, 20
    97 000000B0 F7E3                        MUL BX              
    98 000000B2 89C6                        MOV SI, AX          
    99 000000B4 B91400                      MOV CX, 20          
   100 000000B7 BA1400                      MOV DX, 20          
   101 000000BA BF0F00                      MOV DI, 15          
   102 000000BD B00E                        MOV AL, 14          
   103 000000BF E83500                      CALL desenha_retangulo
   104                                  
   105                                  atualiza_hp2:
   106 000000C2 B9A401                      MOV CX, 420
   107 000000C5 BA1400                      MOV DX, 20
   108 000000C8 BEC800                      MOV SI, 200
   109 000000CB BF0F00                      MOV DI, 15
   110 000000CE B008                        MOV AL, 8           
   111 000000D0 E82400                      CALL desenha_retangulo
   112                                  
   113 000000D3 803E[0000]00                CMP byte [p2_hp], 0
   114 000000D8 741C                        JE fim_desenho      
   115 000000DA A0[0000]                    MOV AL, [p2_hp]
   116 000000DD 30E4                        XOR AH, AH
   117 000000DF BB1400                      MOV BX, 20
   118 000000E2 F7E3                        MUL BX              
   119 000000E4 89C6                        MOV SI, AX          
   120 000000E6 B96C02                      MOV CX, 620         
   121 000000E9 29C1                        SUB CX, AX          
   122 000000EB BA1400                      MOV DX, 20          
   123 000000EE BF0F00                      MOV DI, 15          
   124 000000F1 B00E                        MOV AL, 14          
   125 000000F3 E80100                      CALL desenha_retangulo
   126                                  
   127                                  fim_desenho:
   128 000000F6 C3                          RET
   129                                  
   130                                  ; =========================================================
   131                                  ; FUNÇÃO AUXILIAR: DESENHA RETÂNGULO GENÉRICO
   132                                  ; Parâmetros de Entrada:
   133                                  ; CX = X Inicial | DX = Y Inicial
   134                                  ; SI = Largura   | DI = Altura
   135                                  ; AL = Cor (0 a 15)
   136                                  ; =========================================================
   137                                  desenha_retangulo:
   138 000000F7 81FE0000                    CMP SI, 0
   139 000000FB 7428                        JE fim_retangulo
   140 000000FD 81FF0000                    CMP DI, 0
   141 00000101 7422                        JE fim_retangulo
   142                                  
   143                                      ; Salva o contexto dos registradores para não corromper o chamador
   144 00000103 51                          PUSH CX
   145 00000104 52                          PUSH DX
   146 00000105 56                          PUSH SI
   147 00000106 57                          PUSH DI
   148 00000107 53                          PUSH BX
   149                                      
   150 00000108 89FB                        MOV BX, DI          ; BX será o contador de linhas (Altura)
   151                                  linha:
   152 0000010A 51                          PUSH CX             ; Salva a posição X original da linha
   153 0000010B 53                          PUSH BX             ; Salva a altura restante
   154                                      
   155 0000010C 89F3                        MOV BX, SI          ; BX será o contador de colunas (Largura)
   156                                  coluna:
   157 0000010E B40C                        MOV AH, 0Ch         ; Função de escrever pixel da INT 10h
   158 00000110 53                          PUSH BX             ; Protege o contador de largura da INT 10h
   159 00000111 B700                        MOV BH, 0           ; Página de vídeo 0
   160 00000113 CD10                        INT 10h             
   161 00000115 5B                          POP BX
   162                                      
   163 00000116 41                          INC CX              ; X = X + 1 (Anda um pixel pra direita)
   164 00000117 4B                          DEC BX
   165 00000118 75F4                        JNZ coluna          ; Repete até pintar toda a largura da linha atual
   166                                      
   167 0000011A 5B                          POP BX              ; Recupera a altura restante
   168 0000011B 59                          POP CX              ; Volta o X para a esquerda
   169 0000011C 42                          INC DX              ; Y = Y + 1 (Desce uma linha)
   170 0000011D 4B                          DEC BX
   171 0000011E 75EA                        JNZ linha           ; Repete até pintar todas as linhas (Altura)
   172                                      
   173                                      ; Restaura o contexto
   174 00000120 5B                          POP BX
   175 00000121 5F                          POP DI
   176 00000122 5E                          POP SI
   177 00000123 5A                          POP DX
   178 00000124 59                          POP CX
   179                                  fim_retangulo:
   180 00000125 C3                          RET
