     1                                  segment data public
     2                                      global desenha_cena, desenha_fundo, desenha_pause, apaga_pause, desenha_menu_quit, apaga_menu_quit
     3                                      extern p1_x, p1_y, p1_hp, p1_x_antigo, p1_y_antigo, p1_estado
     4                                      extern p2_x, p2_y, p2_hp, p2_x_antigo, p2_y_antigo, p2_estado
     5 00000000 515549543F20592F4E-         msg_sair db 'QUIT? Y/N', 0
     6 00000009 00                 
     7                                  
     8                                  segment code
     9                                  
    10                                  ; =========================================================
    11                                  ; DESENHA FUNDO: EXECUTADO APENAS 1 VEZ AO INICIAR O JOGO
    12                                  ; =========================================================
    13                                  desenha_fundo:
    14                                      ; 1. Limpa a tela inteira (Preenche de Preto)
    15 00000000 B80006                      MOV AX, 0600h
    16 00000003 B700                        MOV BH, 00h
    17 00000005 B90000                      MOV CX, 0000h
    18 00000008 BA4F1D                      MOV DX, 1D4Fh
    19 0000000B CD10                        INT 10h
    20                                  
    21                                      ; 2. Desenha o Fundo da Barra P1 (Cinza escuro)
    22 0000000D B91400                      MOV CX, 20          ; X inicial
    23 00000010 BA1400                      MOV DX, 20          ; Y inicial
    24 00000013 BEC800                      MOV SI, 200         ; Largura máxima
    25 00000016 BF0F00                      MOV DI, 15          ; Altura
    26 00000019 B008                        MOV AL, 8           ; Cor: 8 (Cinza)
    27 0000001B E8D900                      CALL desenha_retangulo
    28                                  
    29                                      ; 3. Desenha o Fundo da Barra P2 (Cinza escuro)
    30 0000001E B9A401                      MOV CX, 420         ; X inicial (Termina no 620)
    31 00000021 BA1400                      MOV DX, 20
    32 00000024 BEC800                      MOV SI, 200
    33 00000027 BF0F00                      MOV DI, 15
    34 0000002A B008                        MOV AL, 8
    35 0000002C E8C800                      CALL desenha_retangulo
    36                                      
    37 0000002F C3                          RET
    38                                  
    39                                  ; =========================================================
    40                                  ; DESENHA CENA: EXECUTADO A CADA FRAME (18.2 Hz)
    41                                  ; =========================================================
    42                                  desenha_cena:
    43                                      ; --- 1. APAGA OS RASTROS ---
    44                                      ; Apagar sempre vai varrer o quadrado de 20x20 para garantir que 
    45                                      ; nada do frame anterior sobre na tela, mesmo se voltar de um pulo.
    46 00000030 8B0E[0000]                  MOV CX, [p1_x_antigo]
    47 00000034 8B16[0000]                  MOV DX, [p1_y_antigo]
    48 00000038 BE1400                      MOV SI, 20
    49 0000003B BF1400                      MOV DI, 20
    50 0000003E B000                        MOV AL, 0           
    51 00000040 E8B400                      CALL desenha_retangulo
    52                                  
    53 00000043 8B0E[0000]                  MOV CX, [p2_x_antigo]
    54 00000047 8B16[0000]                  MOV DX, [p2_y_antigo]
    55 0000004B BE1400                      MOV SI, 20
    56 0000004E BF1400                      MOV DI, 20
    57 00000051 B000                        MOV AL, 0
    58 00000053 E8A100                      CALL desenha_retangulo
    59                                  
    60                                      ; --- 2. DESENHA OS LUTADORES NAS POSIÇÕES NOVAS ---
    61                                      ; P1
    62 00000056 8B0E[0000]                  MOV CX, [p1_x]
    63 0000005A 8B16[0000]                  MOV DX, [p1_y]
    64 0000005E BE1400                      MOV SI, 20
    65 00000061 BF1400                      MOV DI, 20          ; Altura padrão
    66 00000064 803E[0000]02                CMP byte [p1_estado], 2 ; Checa se P1 está agachado
    67 00000069 7503                        JNE desenha_p1_cor
    68 0000006B BF0A00                      MOV DI, 10          ; Se sim, altura vira 10
    69                                  desenha_p1_cor:
    70 0000006E B009                        MOV AL, 9           ; Azul
    71 00000070 E88400                      CALL desenha_retangulo
    72                                      
    73                                      ; P2
    74 00000073 8B0E[0000]                  MOV CX, [p2_x]
    75 00000077 8B16[0000]                  MOV DX, [p2_y]
    76 0000007B BE1400                      MOV SI, 20
    77 0000007E BF1400                      MOV DI, 20          ; Altura padrão
    78 00000081 803E[0000]02                CMP byte [p2_estado], 2 ; Checa se P2 está agachado
    79 00000086 7503                        JNE desenha_p2_cor
    80 00000088 BF0A00                      MOV DI, 10          ; Se sim, altura vira 10
    81                                  desenha_p2_cor:
    82 0000008B B004                        MOV AL, 4           ; Vermelho
    83 0000008D E86700                      CALL desenha_retangulo
    84                                  
    85                                      ; --- 3. ATUALIZA AS BARRAS DE VIDA (igual ao seu código anterior) ---
    86 00000090 B91400                      MOV CX, 20
    87 00000093 BA1400                      MOV DX, 20
    88 00000096 BEC800                      MOV SI, 200
    89 00000099 BF0F00                      MOV DI, 15
    90 0000009C B008                        MOV AL, 8           
    91 0000009E E85600                      CALL desenha_retangulo
    92                                      
    93 000000A1 803E[0000]00                CMP byte [p1_hp], 0
    94 000000A6 741A                        JE atualiza_hp2     
    95 000000A8 A0[0000]                    MOV AL, [p1_hp]
    96 000000AB 30E4                        XOR AH, AH          
    97 000000AD BB1400                      MOV BX, 20
    98 000000B0 F7E3                        MUL BX              
    99 000000B2 89C6                        MOV SI, AX          
   100 000000B4 B91400                      MOV CX, 20          
   101 000000B7 BA1400                      MOV DX, 20          
   102 000000BA BF0F00                      MOV DI, 15          
   103 000000BD B00E                        MOV AL, 14          
   104 000000BF E83500                      CALL desenha_retangulo
   105                                  
   106                                  atualiza_hp2:
   107 000000C2 B9A401                      MOV CX, 420
   108 000000C5 BA1400                      MOV DX, 20
   109 000000C8 BEC800                      MOV SI, 200
   110 000000CB BF0F00                      MOV DI, 15
   111 000000CE B008                        MOV AL, 8           
   112 000000D0 E82400                      CALL desenha_retangulo
   113                                  
   114 000000D3 803E[0000]00                CMP byte [p2_hp], 0
   115 000000D8 741C                        JE fim_desenho      
   116 000000DA A0[0000]                    MOV AL, [p2_hp]
   117 000000DD 30E4                        XOR AH, AH
   118 000000DF BB1400                      MOV BX, 20
   119 000000E2 F7E3                        MUL BX              
   120 000000E4 89C6                        MOV SI, AX          
   121 000000E6 B96C02                      MOV CX, 620         
   122 000000E9 29C1                        SUB CX, AX          
   123 000000EB BA1400                      MOV DX, 20          
   124 000000EE BF0F00                      MOV DI, 15          
   125 000000F1 B00E                        MOV AL, 14          
   126 000000F3 E80100                      CALL desenha_retangulo
   127                                  
   128                                  fim_desenho:
   129 000000F6 C3                          RET
   130                                  
   131                                  ; =========================================================
   132                                  ; FUNÇÃO AUXILIAR: DESENHA RETÂNGULO GENÉRICO
   133                                  ; Parâmetros de Entrada:
   134                                  ; CX = X Inicial | DX = Y Inicial
   135                                  ; SI = Largura   | DI = Altura
   136                                  ; AL = Cor (0 a 15)
   137                                  ; =========================================================
   138                                  desenha_retangulo:
   139 000000F7 81FE0000                    CMP SI, 0
   140 000000FB 7428                        JE fim_retangulo
   141 000000FD 81FF0000                    CMP DI, 0
   142 00000101 7422                        JE fim_retangulo
   143                                  
   144                                      ; Salva o contexto dos registradores para não corromper o chamador
   145 00000103 51                          PUSH CX
   146 00000104 52                          PUSH DX
   147 00000105 56                          PUSH SI
   148 00000106 57                          PUSH DI
   149 00000107 53                          PUSH BX
   150                                      
   151 00000108 89FB                        MOV BX, DI          ; BX será o contador de linhas (Altura)
   152                                  linha:
   153 0000010A 51                          PUSH CX             ; Salva a posição X original da linha
   154 0000010B 53                          PUSH BX             ; Salva a altura restante
   155                                      
   156 0000010C 89F3                        MOV BX, SI          ; BX será o contador de colunas (Largura)
   157                                  coluna:
   158 0000010E B40C                        MOV AH, 0Ch         ; Função de escrever pixel da INT 10h
   159 00000110 53                          PUSH BX             ; Protege o contador de largura da INT 10h
   160 00000111 B700                        MOV BH, 0           ; Página de vídeo 0
   161 00000113 CD10                        INT 10h             
   162 00000115 5B                          POP BX
   163                                      
   164 00000116 41                          INC CX              ; X = X + 1 (Anda um pixel pra direita)
   165 00000117 4B                          DEC BX
   166 00000118 75F4                        JNZ coluna          ; Repete até pintar toda a largura da linha atual
   167                                      
   168 0000011A 5B                          POP BX              ; Recupera a altura restante
   169 0000011B 59                          POP CX              ; Volta o X para a esquerda
   170 0000011C 42                          INC DX              ; Y = Y + 1 (Desce uma linha)
   171 0000011D 4B                          DEC BX
   172 0000011E 75EA                        JNZ linha           ; Repete até pintar todas as linhas (Altura)
   173                                      
   174                                      ; Restaura o contexto
   175 00000120 5B                          POP BX
   176 00000121 5F                          POP DI
   177 00000122 5E                          POP SI
   178 00000123 5A                          POP DX
   179 00000124 59                          POP CX
   180                                  fim_retangulo:
   181 00000125 C3                          RET
   182                                  
   183                                  desenha_pause:
   184                                      ; Barra esquerda (Branca)
   185 00000126 B93101                      MOV CX, 305         ; Centralizado no X (metade de 640)
   186 00000129 BADC00                      MOV DX, 220         ; Centralizado no Y (metade de 480)
   187 0000012C BE0A00                      MOV SI, 10          ; Largura
   188 0000012F BF2800                      MOV DI, 40          ; Altura
   189 00000132 B00F                        MOV AL, 15          ; Cor: 15 (Branco)
   190 00000134 E8C0FF                      CALL desenha_retangulo
   191                                  
   192                                      ; Barra direita (Branca)
   193 00000137 B94501                      MOV CX, 325         ; 10 pixels de espaço entre as barras
   194 0000013A BADC00                      MOV DX, 220
   195 0000013D BE0A00                      MOV SI, 10
   196 00000140 BF2800                      MOV DI, 40
   197 00000143 B00F                        MOV AL, 15          
   198 00000145 E8AFFF                      CALL desenha_retangulo
   199 00000148 C3                          RET
   200                                  
   201                                  apaga_pause:
   202                                      ; Apaga barra esquerda (Preta)
   203 00000149 B93101                      MOV CX, 305
   204 0000014C BADC00                      MOV DX, 220
   205 0000014F BE0A00                      MOV SI, 10
   206 00000152 BF2800                      MOV DI, 40
   207 00000155 B000                        MOV AL, 0           ; Cor: 0 (Preto - Fundo)
   208 00000157 E89DFF                      CALL desenha_retangulo
   209                                  
   210                                      ; Apaga barra direita (Preta)
   211 0000015A B94501                      MOV CX, 325
   212 0000015D BADC00                      MOV DX, 220
   213 00000160 BE0A00                      MOV SI, 10
   214 00000163 BF2800                      MOV DI, 40
   215 00000166 B000                        MOV AL, 0
   216 00000168 E88CFF                      CALL desenha_retangulo
   217 0000016B C3                          RET
   218                                  
   219                                  desenha_menu_quit:
   220                                      ; 1. Desenha a borda do menu (Branca)
   221 0000016C B9DC00                      MOV CX, 220         ; X
   222 0000016F BAB400                      MOV DX, 180         ; Y
   223 00000172 BEC800                      MOV SI, 200         ; Largura
   224 00000175 BF3C00                      MOV DI, 60          ; Altura
   225 00000178 B00F                        MOV AL, 15          ; Cor 15 (Branco)
   226 0000017A E87AFF                      CALL desenha_retangulo
   227                                  
   228                                      ; 2. Desenha o miolo do menu (Preto)
   229 0000017D B9E100                      MOV CX, 225
   230 00000180 BAB900                      MOV DX, 185
   231 00000183 BEBE00                      MOV SI, 190
   232 00000186 BF3200                      MOV DI, 50
   233 00000189 B000                        MOV AL, 0           ; Cor 0 (Preto)
   234 0000018B E869FF                      CALL desenha_retangulo
   235                                  
   236                                      ; 3. Posiciona o cursor de texto da BIOS
   237 0000018E B402                        MOV AH, 02h
   238 00000190 B700                        MOV BH, 0           ; Página de vídeo
   239 00000192 B60D                        MOV DH, 13          ; Linha (Y do texto)
   240 00000194 B224                        MOV DL, 36          ; Coluna (X do texto)
   241 00000196 CD10                        INT 10h
   242                                  
   243                                      ; 4. Loop de impressão da string (Caracter por caracter)
   244 00000198 BB[0000]                    MOV BX, msg_sair
   245                                      
   246                                  print_loop:
   247 0000019B 8A07                        MOV AL, [BX]        ; Pega o caractere atual da string
   248 0000019D 3C00                        CMP AL, 0           ; Verifica se é o terminador (0)
   249 0000019F 740E                        JE fim_menu_saida   ; Se for zero, acabou a string
   250                                      
   251 000001A1 B40E                        MOV AH, 0Eh         ; Função Teletype da BIOS
   252 000001A3 53                          PUSH BX             ; Salva o ponteiro da string
   253 000001A4 B700                        MOV BH, 0
   254 000001A6 B30E                        MOV BL, 14          ; Cor 14 (Amarelo) para o texto
   255 000001A8 CD10                        INT 10h
   256 000001AA 5B                          POP BX              ; Restaura o ponteiro
   257                                      
   258 000001AB 43                          INC BX              ; Avança pro próximo caractere
   259 000001AC E9ECFF                      JMP print_loop
   260                                  
   261                                  fim_menu_saida:
   262 000001AF C3                          RET
   263                                  
   264                                  apaga_menu_quit:
   265                                      ; Apaga o menu pintando um retângulo preto por cima
   266 000001B0 B9DC00                      MOV CX, 220
   267 000001B3 BAB400                      MOV DX, 180
   268 000001B6 BEC800                      MOV SI, 200
   269 000001B9 BF3C00                      MOV DI, 60
   270 000001BC B000                        MOV AL, 0
   271 000001BE E836FF                      CALL desenha_retangulo
   272 000001C1 C3                          RET
