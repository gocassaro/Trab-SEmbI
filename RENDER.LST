     1                                  segment data public
     2                                      global desenha_cena
     3                                      extern p1_x, p1_y, p1_estado, p1_hp
     4                                      extern p2_x, p2_y, p2_estado, p2_hp
     5                                  
     6                                  segment code
     7                                  
     8                                  desenha_cena:
     9                                      ; ==========================================
    10                                      ; AGUARDA O VSYNC (Sincronização Vertical)
    11                                      ; ==========================================
    12 00000000 BADA03                      MOV DX, 03DAh               ; Porta de status do monitor VGA
    13                                  espera_vblank_fim:
    14 00000003 EC                          IN AL, DX
    15 00000004 A808                        TEST AL, 8                  ; Testa o bit 3 (Vertical Retrace)
    16 00000006 75FB                        JNZ espera_vblank_fim       ; Espera terminar o VSync anterior (se estiver ocorrendo)
    17                                  espera_vblank_inicio:
    18 00000008 EC                          IN AL, DX
    19 00000009 A808                        TEST AL, 8
    20 0000000B 74FB                        JZ espera_vblank_inicio     ; Espera o monitor iniciar o período de VSync
    21                                      
    22                                      ; 1. Limpa a tela (preenche com preto)
    23 0000000D B80006                      MOV AX, 0600h
    24 00000010 B700                        MOV BH, 00h
    25 00000012 B90000                      MOV CX, 0000h
    26 00000015 BA4F1D                      MOV DX, 1D4Fh
    27 00000018 CD10                        INT 10h
    28                                  
    29                                      ; ==========================================
    30                                      ; INTERFACE: BARRAS DE ENERGIA (FUNDO CINZA)
    31                                      ; ==========================================
    32                                      
    33                                      ; Fundo Barra P1 (Canto Superior Esquerdo)
    34 0000001A B91400                      MOV CX, 20          ; X = 20
    35 0000001D BA1400                      MOV DX, 20          ; Y = 20
    36 00000020 BEC800                      MOV SI, 200         ; Largura = 200 (10 HP * 20 pixels)
    37 00000023 BF0F00                      MOV DI, 15          ; Altura = 15
    38 00000026 B008                        MOV AL, 8           ; Cor: Cinza (Código 8)
    39 00000028 E87C00                      CALL desenha_retangulo
    40                                  
    41                                      ; Fundo Barra P2 (Canto Superior Direito)
    42 0000002B B9A401                      MOV CX, 420         ; X = 420 (Termina no X=620)
    43 0000002E BA1400                      MOV DX, 20          ; Y = 20
    44 00000031 BEC800                      MOV SI, 200         ; Largura = 200
    45 00000034 BF0F00                      MOV DI, 15          ; Altura = 15
    46 00000037 B008                        MOV AL, 8           ; Cor: Cinza
    47 00000039 E86B00                      CALL desenha_retangulo
    48                                  
    49                                      ; ==========================================
    50                                      ; INTERFACE: ENERGIA ATUAL (BARRAS AMARELAS)
    51                                      ; ==========================================
    52                                      
    53                                      ; Vida Atual P1
    54 0000003C 803E[0000]00                CMP byte [p1_hp], 0
    55 00000041 741A                        JE hp2_check        ; Se HP for 0, não desenha a barra amarela
    56                                      
    57 00000043 A0[0000]                    MOV AL, [p1_hp]
    58 00000046 30E4                        XOR AH, AH          ; Limpa AH, deixando apenas p1_hp em AX
    59 00000048 BB1400                      MOV BX, 20
    60 0000004B F7E3                        MUL BX              ; AX = HP * 20 (Calcula a largura atual)
    61 0000004D 89C6                        MOV SI, AX          ; Largura
    62 0000004F B91400                      MOV CX, 20          ; X = 20
    63 00000052 BA1400                      MOV DX, 20          ; Y = 20
    64 00000055 BF0F00                      MOV DI, 15          ; Altura
    65 00000058 B00E                        MOV AL, 14          ; Cor: Amarelo
    66 0000005A E84A00                      CALL desenha_retangulo
    67                                  
    68                                  hp2_check:
    69                                      ; Vida Atual P2
    70 0000005D 803E[0000]00                CMP byte [p2_hp], 0
    71 00000062 741C                        JE draw_players     ; Se HP for 0, pula
    72                                      
    73 00000064 A0[0000]                    MOV AL, [p2_hp]
    74 00000067 30E4                        XOR AH, AH
    75 00000069 BB1400                      MOV BX, 20
    76 0000006C F7E3                        MUL BX              ; AX = HP * 20
    77 0000006E 89C6                        MOV SI, AX          ; Largura
    78 00000070 B96C02                      MOV CX, 620         ; Borda direita máxima da barra
    79 00000073 29C1                        SUB CX, AX          ; Subtrai a largura para a barra "encolher" para a direita
    80 00000075 BA1400                      MOV DX, 20          ; Y = 20
    81 00000078 BF0F00                      MOV DI, 15          ; Altura
    82 0000007B B00E                        MOV AL, 14          ; Cor: Amarelo
    83 0000007D E82700                      CALL desenha_retangulo
    84                                  
    85                                  draw_players:
    86                                      ; ==========================================
    87                                      ; DESENHA OS LUTADORES
    88                                      ; ==========================================
    89                                      
    90                                      ; Desenha P1
    91 00000080 8B0E[0000]                  MOV CX, [p1_x]
    92 00000084 8B16[0000]                  MOV DX, [p1_y]
    93 00000088 BE1400                      MOV SI, 20          ; Largura 20
    94 0000008B BF1400                      MOV DI, 20          ; Altura 20
    95 0000008E B009                        MOV AL, 9           ; Cor: Azul
    96 00000090 E81400                      CALL desenha_retangulo
    97                                      
    98                                      ; Desenha P2
    99 00000093 8B0E[0000]                  MOV CX, [p2_x]
   100 00000097 8B16[0000]                  MOV DX, [p2_y]
   101 0000009B BE1400                      MOV SI, 20          ; Largura 20
   102 0000009E BF1400                      MOV DI, 20          ; Altura 20
   103 000000A1 B004                        MOV AL, 4           ; Cor: Vermelho
   104 000000A3 E80100                      CALL desenha_retangulo
   105                                      
   106 000000A6 C3                          RET
   107                                  
   108                                  ; ==========================================
   109                                  ; FUNÇÃO: DESENHA RETÂNGULO GENÉRICO
   110                                  ; Parâmetros:
   111                                  ; CX = Posição X Inicial
   112                                  ; DX = Posição Y Inicial
   113                                  ; SI = Largura
   114                                  ; DI = Altura
   115                                  ; AL = Cor (0 a 15)
   116                                  ; ==========================================
   117                                  desenha_retangulo:
   118 000000A7 81FE0000                    CMP SI, 0
   119 000000AB 7428                        JE fim_retangulo
   120 000000AD 81FF0000                    CMP DI, 0
   121 000000B1 7422                        JE fim_retangulo
   122                                  
   123 000000B3 51                          PUSH CX
   124 000000B4 52                          PUSH DX
   125 000000B5 56                          PUSH SI
   126 000000B6 57                          PUSH DI
   127 000000B7 53                          PUSH BX
   128                                      
   129 000000B8 89FB                        MOV BX, DI          ; Passa a altura para o contador BX
   130                                  linha:
   131 000000BA 51                          PUSH CX             ; Salva X inicial da linha
   132 000000BB 53                          PUSH BX             ; Salva a altura restante
   133                                      
   134 000000BC 89F3                        MOV BX, SI          ; Passa a largura para o contador BX
   135                                  coluna:
   136 000000BE B40C                        MOV AH, 0Ch         ; INT 10h, 0Ch: Escrever pixel gráfico
   137 000000C0 53                          PUSH BX             
   138 000000C1 B700                        MOV BH, 0           
   139 000000C3 CD10                        INT 10h             
   140 000000C5 5B                          POP BX
   141                                      
   142 000000C6 41                          INC CX              ; Avança 1 pixel para a direita
   143 000000C7 4B                          DEC BX
   144 000000C8 75F4                        JNZ coluna          ; Continua até terminar a largura
   145                                      
   146 000000CA 5B                          POP BX              ; Recupera a altura restante
   147 000000CB 59                          POP CX              ; Volta o X para o começo da linha
   148 000000CC 42                          INC DX              ; Desce 1 pixel (Y = Y + 1)
   149 000000CD 4B                          DEC BX
   150 000000CE 75EA                        JNZ linha           ; Continua até terminar a altura
   151                                      
   152 000000D0 5B                          POP BX
   153 000000D1 5F                          POP DI
   154 000000D2 5E                          POP SI
   155 000000D3 5A                          POP DX
   156 000000D4 59                          POP CX
   157                                  fim_retangulo:
   158 000000D5 C3                          RET
   159                                  
   160                                  ; segment data public
   161                                  ;     global desenha_cena
   162                                  ;     extern p1_x, p1_y, p1_estado
   163                                  ;     extern p2_x, p2_y, p2_estado
   164                                  
   165                                  ; segment code
   166                                  ; desenha_cena:
   167                                  ;     ; 1. Limpa a tela pintando o fundo de preto
   168                                  ;     ; (Usamos a rolagem da BIOS, que é muito mais rápida que pintar pixel por pixel)
   169                                  ;     MOV AX, 0600h       ; Função de rolar a janela (AL=0 limpa a tela)
   170                                  ;     MOV BH, 00h         ; Cor do fundo (Preto)
   171                                  ;     MOV CX, 0000h       ; Canto superior esquerdo (X=0, Y=0)
   172                                  ;     MOV DX, 1D4Fh       ; Canto inferior direito (VGA 640x480)
   173                                  ;     INT 10h
   174                                  
   175                                  ;     ; 2. Desenha o Jogador 1 (Azul = 9)
   176                                  ;     MOV CX, [p1_x]
   177                                  ;     MOV DX, [p1_y]
   178                                  ;     MOV AL, 9
   179                                  ;     CALL desenha_quadrado
   180                                      
   181                                  ;     ; 3. Desenha o Jogador 2 (Vermelho = 4)
   182                                  ;     MOV CX, [p2_x]
   183                                  ;     MOV DX, [p2_y]
   184                                  ;     MOV AL, 4
   185                                  ;     CALL desenha_quadrado
   186                                      
   187                                  ;     RET
   188                                  
   189                                  ; ; Função que desenha um bloco 20x20
   190                                  ; desenha_quadrado:
   191                                  ;     PUSH CX
   192                                  ;     PUSH DX
   193                                  ;     PUSH BX
   194                                      
   195                                  ;     MOV BX, 20          ; Altura = 20 pixels
   196                                  ; linha:
   197                                  ;     PUSH CX             ; Salva a coordenada X do início da linha
   198                                  ;     PUSH BX             ; Salva a altura restante
   199                                      
   200                                  ;     MOV BX, 20          ; Largura = 20 pixels
   201                                  ; coluna:
   202                                  ;     MOV AH, 0Ch         ; Função da BIOS de desenhar pixel
   203                                  ;     PUSH BX             ; Salva a largura restante
   204                                  ;     MOV BH, 0           ; Página de vídeo
   205                                  ;     INT 10h             ; Pinta o pixel nas coordenadas CX, DX
   206                                  ;     POP BX
   207                                      
   208                                  ;     INC CX              ; Anda 1 pixel para a direita
   209                                  ;     DEC BX
   210                                  ;     JNZ coluna          ; Repete até terminar a largura
   211                                      
   212                                  ;     POP BX              ; Recupera a altura restante
   213                                  ;     POP CX              ; Volta a coordenada X para o início da coluna
   214                                  ;     INC DX              ; Desce 1 pixel (próxima linha)
   215                                  ;     DEC BX
   216                                  ;     JNZ linha           ; Repete até terminar a altura
   217                                      
   218                                  ;     POP BX
   219                                  ;     POP DX
   220                                  ;     POP CX
   221                                  ;     RET
   222                                  
   223                                  ;; =========================================== ;;
   224                                  
   225                                  ; segment data public
   226                                  ;     global desenha_cena
   227                                  ;     extern p1_x, p1_y, p1_estado
   228                                  ;     extern p2_x, p2_y, p2_estado
   229                                  
   230                                  ; segment code
   231                                  ; desenha_cena:
   232                                  ;     ; (Aqui você pode incluir uma macro para limpar a tela desenhando um retângulo preto de 640x480)
   233                                      
   234                                  ;     ; Desenha P1
   235                                  ;     MOV CX, [p1_x]
   236                                  ;     MOV DX, [p1_y]
   237                                  ;     MOV AL, 9           ; Cor Azul para P1
   238                                  ;     CALL desenha_lutador_placeholder
   239                                      
   240                                  ;     ; Desenha P2
   241                                  ;     MOV CX, [p2_x]
   242                                  ;     MOV DX, [p2_y]
   243                                  ;     MOV AL, 4           ; Cor Vermelha para P2
   244                                  ;     CALL desenha_lutador_placeholder
   245                                      
   246                                  ;     RET
   247                                  
   248                                  ; desenha_lutador_placeholder:
   249                                  ;     ; CX = X, DX = Y, AL = Cor
   250                                  ;     ; Essa função desenharia um retângulo base.
   251                                  ;     ; Se p1_estado == 2 (Agachado), desenha retângulo menor.
   252                                  ;     ; Se p1_estado == 4 (Soco), desenha um braço estendido (uma linha reta).
   253                                      
   254                                  ;     ; Exemplo de Ponto (Use plot_xy do lab05 na versão final[cite: 6])
   255                                  ;     MOV AH, 0Ch
   256                                  ;     MOV BH, 0
   257                                  ;     INT 10h
   258                                  ;     RET
