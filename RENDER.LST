     1                                  segment data public
     2                                      global desenha_cena, desenha_fundo, desenha_pause, apaga_pause
     3                                      extern p1_x, p1_y, p1_hp, p1_x_antigo, p1_y_antigo, p1_estado
     4                                      extern p2_x, p2_y, p2_hp, p2_x_antigo, p2_y_antigo, p2_estado
     5                                  
     6                                  segment code
     7                                  
     8                                  ; =========================================================
     9                                  ; DESENHA FUNDO: EXECUTADO APENAS 1 VEZ AO INICIAR O JOGO
    10                                  ; =========================================================
    11                                  desenha_fundo:
    12                                      ; 1. Limpa a tela inteira (Preenche de Preto)
    13 00000000 B80006                      MOV AX, 0600h
    14 00000003 B700                        MOV BH, 00h
    15 00000005 B90000                      MOV CX, 0000h
    16 00000008 BA4F1D                      MOV DX, 1D4Fh
    17 0000000B CD10                        INT 10h
    18                                  
    19                                      ; 2. Desenha o Fundo da Barra P1 (Cinza escuro)
    20 0000000D B91400                      MOV CX, 20          ; X inicial
    21 00000010 BA1400                      MOV DX, 20          ; Y inicial
    22 00000013 BEC800                      MOV SI, 200         ; Largura máxima
    23 00000016 BF0F00                      MOV DI, 15          ; Altura
    24 00000019 B008                        MOV AL, 8           ; Cor: 8 (Cinza)
    25 0000001B E8D900                      CALL desenha_retangulo
    26                                  
    27                                      ; 3. Desenha o Fundo da Barra P2 (Cinza escuro)
    28 0000001E B9A401                      MOV CX, 420         ; X inicial (Termina no 620)
    29 00000021 BA1400                      MOV DX, 20
    30 00000024 BEC800                      MOV SI, 200
    31 00000027 BF0F00                      MOV DI, 15
    32 0000002A B008                        MOV AL, 8
    33 0000002C E8C800                      CALL desenha_retangulo
    34                                      
    35 0000002F C3                          RET
    36                                  
    37                                  ; =========================================================
    38                                  ; DESENHA CENA: EXECUTADO A CADA FRAME (18.2 Hz)
    39                                  ; =========================================================
    40                                  desenha_cena:
    41                                      ; --- 1. APAGA OS RASTROS ---
    42                                      ; Apagar sempre vai varrer o quadrado de 20x20 para garantir que 
    43                                      ; nada do frame anterior sobre na tela, mesmo se voltar de um pulo.
    44 00000030 8B0E[0000]                  MOV CX, [p1_x_antigo]
    45 00000034 8B16[0000]                  MOV DX, [p1_y_antigo]
    46 00000038 BE1400                      MOV SI, 20
    47 0000003B BF1400                      MOV DI, 20
    48 0000003E B000                        MOV AL, 0           
    49 00000040 E8B400                      CALL desenha_retangulo
    50                                  
    51 00000043 8B0E[0000]                  MOV CX, [p2_x_antigo]
    52 00000047 8B16[0000]                  MOV DX, [p2_y_antigo]
    53 0000004B BE1400                      MOV SI, 20
    54 0000004E BF1400                      MOV DI, 20
    55 00000051 B000                        MOV AL, 0
    56 00000053 E8A100                      CALL desenha_retangulo
    57                                  
    58                                      ; --- 2. DESENHA OS LUTADORES NAS POSIÇÕES NOVAS ---
    59                                      ; P1
    60 00000056 8B0E[0000]                  MOV CX, [p1_x]
    61 0000005A 8B16[0000]                  MOV DX, [p1_y]
    62 0000005E BE1400                      MOV SI, 20
    63 00000061 BF1400                      MOV DI, 20          ; Altura padrão
    64 00000064 803E[0000]02                CMP byte [p1_estado], 2 ; Checa se P1 está agachado
    65 00000069 7503                        JNE desenha_p1_cor
    66 0000006B BF0A00                      MOV DI, 10          ; Se sim, altura vira 10
    67                                  desenha_p1_cor:
    68 0000006E B009                        MOV AL, 9           ; Azul
    69 00000070 E88400                      CALL desenha_retangulo
    70                                      
    71                                      ; P2
    72 00000073 8B0E[0000]                  MOV CX, [p2_x]
    73 00000077 8B16[0000]                  MOV DX, [p2_y]
    74 0000007B BE1400                      MOV SI, 20
    75 0000007E BF1400                      MOV DI, 20          ; Altura padrão
    76 00000081 803E[0000]02                CMP byte [p2_estado], 2 ; Checa se P2 está agachado
    77 00000086 7503                        JNE desenha_p2_cor
    78 00000088 BF0A00                      MOV DI, 10          ; Se sim, altura vira 10
    79                                  desenha_p2_cor:
    80 0000008B B004                        MOV AL, 4           ; Vermelho
    81 0000008D E86700                      CALL desenha_retangulo
    82                                  
    83                                      ; --- 3. ATUALIZA AS BARRAS DE VIDA (igual ao seu código anterior) ---
    84 00000090 B91400                      MOV CX, 20
    85 00000093 BA1400                      MOV DX, 20
    86 00000096 BEC800                      MOV SI, 200
    87 00000099 BF0F00                      MOV DI, 15
    88 0000009C B008                        MOV AL, 8           
    89 0000009E E85600                      CALL desenha_retangulo
    90                                      
    91 000000A1 803E[0000]00                CMP byte [p1_hp], 0
    92 000000A6 741A                        JE atualiza_hp2     
    93 000000A8 A0[0000]                    MOV AL, [p1_hp]
    94 000000AB 30E4                        XOR AH, AH          
    95 000000AD BB1400                      MOV BX, 20
    96 000000B0 F7E3                        MUL BX              
    97 000000B2 89C6                        MOV SI, AX          
    98 000000B4 B91400                      MOV CX, 20          
    99 000000B7 BA1400                      MOV DX, 20          
   100 000000BA BF0F00                      MOV DI, 15          
   101 000000BD B00E                        MOV AL, 14          
   102 000000BF E83500                      CALL desenha_retangulo
   103                                  
   104                                  atualiza_hp2:
   105 000000C2 B9A401                      MOV CX, 420
   106 000000C5 BA1400                      MOV DX, 20
   107 000000C8 BEC800                      MOV SI, 200
   108 000000CB BF0F00                      MOV DI, 15
   109 000000CE B008                        MOV AL, 8           
   110 000000D0 E82400                      CALL desenha_retangulo
   111                                  
   112 000000D3 803E[0000]00                CMP byte [p2_hp], 0
   113 000000D8 741C                        JE fim_desenho      
   114 000000DA A0[0000]                    MOV AL, [p2_hp]
   115 000000DD 30E4                        XOR AH, AH
   116 000000DF BB1400                      MOV BX, 20
   117 000000E2 F7E3                        MUL BX              
   118 000000E4 89C6                        MOV SI, AX          
   119 000000E6 B96C02                      MOV CX, 620         
   120 000000E9 29C1                        SUB CX, AX          
   121 000000EB BA1400                      MOV DX, 20          
   122 000000EE BF0F00                      MOV DI, 15          
   123 000000F1 B00E                        MOV AL, 14          
   124 000000F3 E80100                      CALL desenha_retangulo
   125                                  
   126                                  fim_desenho:
   127 000000F6 C3                          RET
   128                                  
   129                                  ; =========================================================
   130                                  ; FUNÇÃO AUXILIAR: DESENHA RETÂNGULO GENÉRICO
   131                                  ; Parâmetros de Entrada:
   132                                  ; CX = X Inicial | DX = Y Inicial
   133                                  ; SI = Largura   | DI = Altura
   134                                  ; AL = Cor (0 a 15)
   135                                  ; =========================================================
   136                                  desenha_retangulo:
   137 000000F7 81FE0000                    CMP SI, 0
   138 000000FB 7428                        JE fim_retangulo
   139 000000FD 81FF0000                    CMP DI, 0
   140 00000101 7422                        JE fim_retangulo
   141                                  
   142                                      ; Salva o contexto dos registradores para não corromper o chamador
   143 00000103 51                          PUSH CX
   144 00000104 52                          PUSH DX
   145 00000105 56                          PUSH SI
   146 00000106 57                          PUSH DI
   147 00000107 53                          PUSH BX
   148                                      
   149 00000108 89FB                        MOV BX, DI          ; BX será o contador de linhas (Altura)
   150                                  linha:
   151 0000010A 51                          PUSH CX             ; Salva a posição X original da linha
   152 0000010B 53                          PUSH BX             ; Salva a altura restante
   153                                      
   154 0000010C 89F3                        MOV BX, SI          ; BX será o contador de colunas (Largura)
   155                                  coluna:
   156 0000010E B40C                        MOV AH, 0Ch         ; Função de escrever pixel da INT 10h
   157 00000110 53                          PUSH BX             ; Protege o contador de largura da INT 10h
   158 00000111 B700                        MOV BH, 0           ; Página de vídeo 0
   159 00000113 CD10                        INT 10h             
   160 00000115 5B                          POP BX
   161                                      
   162 00000116 41                          INC CX              ; X = X + 1 (Anda um pixel pra direita)
   163 00000117 4B                          DEC BX
   164 00000118 75F4                        JNZ coluna          ; Repete até pintar toda a largura da linha atual
   165                                      
   166 0000011A 5B                          POP BX              ; Recupera a altura restante
   167 0000011B 59                          POP CX              ; Volta o X para a esquerda
   168 0000011C 42                          INC DX              ; Y = Y + 1 (Desce uma linha)
   169 0000011D 4B                          DEC BX
   170 0000011E 75EA                        JNZ linha           ; Repete até pintar todas as linhas (Altura)
   171                                      
   172                                      ; Restaura o contexto
   173 00000120 5B                          POP BX
   174 00000121 5F                          POP DI
   175 00000122 5E                          POP SI
   176 00000123 5A                          POP DX
   177 00000124 59                          POP CX
   178                                  fim_retangulo:
   179 00000125 C3                          RET
   180                                  
   181                                  desenha_pause:
   182                                      ; Barra esquerda (Branca)
   183 00000126 B93101                      MOV CX, 305         ; Centralizado no X (metade de 640)
   184 00000129 BADC00                      MOV DX, 220         ; Centralizado no Y (metade de 480)
   185 0000012C BE0A00                      MOV SI, 10          ; Largura
   186 0000012F BF2800                      MOV DI, 40          ; Altura
   187 00000132 B00F                        MOV AL, 15          ; Cor: 15 (Branco)
   188 00000134 E8C0FF                      CALL desenha_retangulo
   189                                  
   190                                      ; Barra direita (Branca)
   191 00000137 B94501                      MOV CX, 325         ; 10 pixels de espaço entre as barras
   192 0000013A BADC00                      MOV DX, 220
   193 0000013D BE0A00                      MOV SI, 10
   194 00000140 BF2800                      MOV DI, 40
   195 00000143 B00F                        MOV AL, 15          
   196 00000145 E8AFFF                      CALL desenha_retangulo
   197 00000148 C3                          RET
   198                                  
   199                                  apaga_pause:
   200                                      ; Apaga barra esquerda (Preta)
   201 00000149 B93101                      MOV CX, 305
   202 0000014C BADC00                      MOV DX, 220
   203 0000014F BE0A00                      MOV SI, 10
   204 00000152 BF2800                      MOV DI, 40
   205 00000155 B000                        MOV AL, 0           ; Cor: 0 (Preto - Fundo)
   206 00000157 E89DFF                      CALL desenha_retangulo
   207                                  
   208                                      ; Apaga barra direita (Preta)
   209 0000015A B94501                      MOV CX, 325
   210 0000015D BADC00                      MOV DX, 220
   211 00000160 BE0A00                      MOV SI, 10
   212 00000163 BF2800                      MOV DI, 40
   213 00000166 B000                        MOV AL, 0
   214 00000168 E88CFF                      CALL desenha_retangulo
   215 0000016B C3                          RET
