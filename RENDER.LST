     1                                  segment data public
     2                                      global desenha_cena
     3                                      global desenha_fundo
     4                                      extern p1_x, p1_y, p1_hp, p1_x_antigo, p1_y_antigo
     5                                      extern p2_x, p2_y, p2_hp, p2_x_antigo, p2_y_antigo
     6                                  
     7                                  segment code
     8                                  
     9                                  ; =========================================================
    10                                  ; DESENHA FUNDO: EXECUTADO APENAS 1 VEZ AO INICIAR O JOGO
    11                                  ; =========================================================
    12                                  desenha_fundo:
    13                                      ; 1. Limpa a tela inteira (Preenche de Preto)
    14 00000000 B80006                      MOV AX, 0600h
    15 00000003 B700                        MOV BH, 00h
    16 00000005 B90000                      MOV CX, 0000h
    17 00000008 BA4F1D                      MOV DX, 1D4Fh
    18 0000000B CD10                        INT 10h
    19                                  
    20                                      ; 2. Desenha o Fundo da Barra P1 (Cinza escuro)
    21 0000000D B91400                      MOV CX, 20          ; X inicial
    22 00000010 BA1400                      MOV DX, 20          ; Y inicial
    23 00000013 BEC800                      MOV SI, 200         ; Largura máxima
    24 00000016 BF0F00                      MOV DI, 15          ; Altura
    25 00000019 B008                        MOV AL, 8           ; Cor: 8 (Cinza)
    26 0000001B E8C500                      CALL desenha_retangulo
    27                                  
    28                                      ; 3. Desenha o Fundo da Barra P2 (Cinza escuro)
    29 0000001E B9A401                      MOV CX, 420         ; X inicial (Termina no 620)
    30 00000021 BA1400                      MOV DX, 20
    31 00000024 BEC800                      MOV SI, 200
    32 00000027 BF0F00                      MOV DI, 15
    33 0000002A B008                        MOV AL, 8
    34 0000002C E8B400                      CALL desenha_retangulo
    35                                      
    36 0000002F C3                          RET
    37                                  
    38                                  ; =========================================================
    39                                  ; DESENHA CENA: EXECUTADO A CADA FRAME (18.2 Hz)
    40                                  ; =========================================================
    41                                  desenha_cena:
    42                                      
    43                                      ; --- 1. APAGA OS RASTROS (Dirty Rectangles) ---
    44                                      ; Pinta um quadrado PRETO (cor 0) exatamente na posição ANTIGA do P1
    45 00000030 8B0E[0000]                  MOV CX, [p1_x_antigo]
    46 00000034 8B16[0000]                  MOV DX, [p1_y_antigo]
    47 00000038 BE1400                      MOV SI, 20
    48 0000003B BF1400                      MOV DI, 20
    49 0000003E B000                        MOV AL, 0           
    50 00000040 E8A000                      CALL desenha_retangulo
    51                                  
    52                                      ; Pinta um quadrado PRETO na posição ANTIGA do P2
    53 00000043 8B0E[0000]                  MOV CX, [p2_x_antigo]
    54 00000047 8B16[0000]                  MOV DX, [p2_y_antigo]
    55 0000004B BE1400                      MOV SI, 20
    56 0000004E BF1400                      MOV DI, 20
    57 00000051 B000                        MOV AL, 0
    58 00000053 E88D00                      CALL desenha_retangulo
    59                                  
    60                                      ; --- 2. DESENHA OS LUTADORES NAS POSIÇÕES NOVAS ---
    61                                      ; Desenha P1 na posição atual
    62 00000056 8B0E[0000]                  MOV CX, [p1_x]
    63 0000005A 8B16[0000]                  MOV DX, [p1_y]
    64 0000005E BE1400                      MOV SI, 20
    65 00000061 BF1400                      MOV DI, 20
    66 00000064 B009                        MOV AL, 9           ; Cor: 9 (Azul)
    67 00000066 E87A00                      CALL desenha_retangulo
    68                                      
    69                                      ; Desenha P2 na posição atual
    70 00000069 8B0E[0000]                  MOV CX, [p2_x]
    71 0000006D 8B16[0000]                  MOV DX, [p2_y]
    72 00000071 BE1400                      MOV SI, 20
    73 00000074 BF1400                      MOV DI, 20
    74 00000077 B004                        MOV AL, 4           ; Cor: 4 (Vermelho)
    75 00000079 E86700                      CALL desenha_retangulo
    76                                  
    77                                      ; --- 3. ATUALIZA AS BARRAS DE VIDA DINAMICAMENTE ---
    78                                      
    79                                      ; > Repinta todo o Fundo Cinza do P1
    80 0000007C B91400                      MOV CX, 20
    81 0000007F BA1400                      MOV DX, 20
    82 00000082 BEC800                      MOV SI, 200
    83 00000085 BF0F00                      MOV DI, 15
    84 00000088 B008                        MOV AL, 8           
    85 0000008A E85600                      CALL desenha_retangulo
    86                                      
    87                                      ; > Desenha a Energia Amarela do P1 por cima
    88 0000008D 803E[0000]00                CMP byte [p1_hp], 0
    89 00000092 741A                        JE atualiza_hp2     ; Se a vida for 0, pula e deixa só o cinza
    90                                      
    91 00000094 A0[0000]                    MOV AL, [p1_hp]
    92 00000097 30E4                        XOR AH, AH          ; Limpa AH (AX agora tem o valor de HP)
    93 00000099 BB1400                      MOV BX, 20
    94 0000009C F7E3                        MUL BX              ; Multiplica AX por BX (Resultado vai para DX:AX)
    95 0000009E 89C6                        MOV SI, AX          ; SI recebe a nova largura calculada (HP * 20)
    96                                      
    97                                      ; Como a instrução MUL afeta o DX, precisamos restaurar as coordenadas Y e Altura
    98 000000A0 B91400                      MOV CX, 20          ; X
    99 000000A3 BA1400                      MOV DX, 20          ; Y
   100 000000A6 BF0F00                      MOV DI, 15          ; Altura
   101 000000A9 B00E                        MOV AL, 14          ; Cor: 14 (Amarelo)
   102 000000AB E83500                      CALL desenha_retangulo
   103                                  
   104                                  atualiza_hp2:
   105                                      ; > Repinta todo o Fundo Cinza do P2
   106 000000AE B9A401                      MOV CX, 420
   107 000000B1 BA1400                      MOV DX, 20
   108 000000B4 BEC800                      MOV SI, 200
   109 000000B7 BF0F00                      MOV DI, 15
   110 000000BA B008                        MOV AL, 8           
   111 000000BC E82400                      CALL desenha_retangulo
   112                                  
   113                                      ; > Desenha a Energia Amarela do P2 por cima
   114 000000BF 803E[0000]00                CMP byte [p2_hp], 0
   115 000000C4 741C                        JE fim_desenho      ; Se a vida for 0, termina a renderização
   116                                      
   117 000000C6 A0[0000]                    MOV AL, [p2_hp]
   118 000000C9 30E4                        XOR AH, AH
   119 000000CB BB1400                      MOV BX, 20
   120 000000CE F7E3                        MUL BX              ; DX:AX = HP * 20
   121 000000D0 89C6                        MOV SI, AX          ; SI = Largura
   122                                      
   123 000000D2 B96C02                      MOV CX, 620         ; Borda máxima direita da barra
   124 000000D5 29C1                        SUB CX, AX          ; Subtrai a largura para "encolher" da esquerda para a direita
   125                                      
   126                                      ; Restaura coordenadas após o MUL
   127 000000D7 BA1400                      MOV DX, 20          ; Y
   128 000000DA BF0F00                      MOV DI, 15          ; Altura
   129 000000DD B00E                        MOV AL, 14          ; Cor: Amarelo
   130 000000DF E80100                      CALL desenha_retangulo
   131                                  
   132                                  fim_desenho:
   133 000000E2 C3                          RET
   134                                  
   135                                  ; =========================================================
   136                                  ; FUNÇÃO AUXILIAR: DESENHA RETÂNGULO GENÉRICO
   137                                  ; Parâmetros de Entrada:
   138                                  ; CX = X Inicial | DX = Y Inicial
   139                                  ; SI = Largura   | DI = Altura
   140                                  ; AL = Cor (0 a 15)
   141                                  ; =========================================================
   142                                  desenha_retangulo:
   143 000000E3 81FE0000                    CMP SI, 0
   144 000000E7 7428                        JE fim_retangulo
   145 000000E9 81FF0000                    CMP DI, 0
   146 000000ED 7422                        JE fim_retangulo
   147                                  
   148                                      ; Salva o contexto dos registradores para não corromper o chamador
   149 000000EF 51                          PUSH CX
   150 000000F0 52                          PUSH DX
   151 000000F1 56                          PUSH SI
   152 000000F2 57                          PUSH DI
   153 000000F3 53                          PUSH BX
   154                                      
   155 000000F4 89FB                        MOV BX, DI          ; BX será o contador de linhas (Altura)
   156                                  linha:
   157 000000F6 51                          PUSH CX             ; Salva a posição X original da linha
   158 000000F7 53                          PUSH BX             ; Salva a altura restante
   159                                      
   160 000000F8 89F3                        MOV BX, SI          ; BX será o contador de colunas (Largura)
   161                                  coluna:
   162 000000FA B40C                        MOV AH, 0Ch         ; Função de escrever pixel da INT 10h
   163 000000FC 53                          PUSH BX             ; Protege o contador de largura da INT 10h
   164 000000FD B700                        MOV BH, 0           ; Página de vídeo 0
   165 000000FF CD10                        INT 10h             
   166 00000101 5B                          POP BX
   167                                      
   168 00000102 41                          INC CX              ; X = X + 1 (Anda um pixel pra direita)
   169 00000103 4B                          DEC BX
   170 00000104 75F4                        JNZ coluna          ; Repete até pintar toda a largura da linha atual
   171                                      
   172 00000106 5B                          POP BX              ; Recupera a altura restante
   173 00000107 59                          POP CX              ; Volta o X para a esquerda
   174 00000108 42                          INC DX              ; Y = Y + 1 (Desce uma linha)
   175 00000109 4B                          DEC BX
   176 0000010A 75EA                        JNZ linha           ; Repete até pintar todas as linhas (Altura)
   177                                      
   178                                      ; Restaura o contexto
   179 0000010C 5B                          POP BX
   180 0000010D 5F                          POP DI
   181 0000010E 5E                          POP SI
   182 0000010F 5A                          POP DX
   183 00000110 59                          POP CX
   184                                  fim_retangulo:
   185 00000111 C3                          RET
