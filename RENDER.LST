     1                                  segment data public
     2                                      global desenha_cena
     3                                      extern p1_x, p1_y, p1_estado, p1_hp
     4                                      extern p2_x, p2_y, p2_estado, p2_hp
     5                                  
     6                                  segment code
     7                                  desenha_cena:
     8                                      ; 1. Limpa a tela (preenche com preto)
     9 00000000 B80006                      MOV AX, 0600h
    10 00000003 B700                        MOV BH, 00h
    11 00000005 B90000                      MOV CX, 0000h
    12 00000008 BA4F1D                      MOV DX, 1D4Fh
    13 0000000B CD10                        INT 10h
    14                                  
    15                                      ; ==========================================
    16                                      ; INTERFACE: BARRAS DE ENERGIA (FUNDO CINZA)
    17                                      ; ==========================================
    18                                      
    19                                      ; Fundo Barra P1 (Canto Superior Esquerdo)
    20 0000000D B91400                      MOV CX, 20          ; X = 20
    21 00000010 BA1400                      MOV DX, 20          ; Y = 20
    22 00000013 BEC800                      MOV SI, 200         ; Largura = 200 (10 HP * 20 pixels)
    23 00000016 BF0F00                      MOV DI, 15          ; Altura = 15
    24 00000019 B008                        MOV AL, 8           ; Cor: Cinza (Código 8)
    25 0000001B E87C00                      CALL desenha_retangulo
    26                                  
    27                                      ; Fundo Barra P2 (Canto Superior Direito)
    28 0000001E B9A401                      MOV CX, 420         ; X = 420 (Termina no X=620)
    29 00000021 BA1400                      MOV DX, 20          ; Y = 20
    30 00000024 BEC800                      MOV SI, 200         ; Largura = 200
    31 00000027 BF0F00                      MOV DI, 15          ; Altura = 15
    32 0000002A B008                        MOV AL, 8           ; Cor: Cinza
    33 0000002C E86B00                      CALL desenha_retangulo
    34                                  
    35                                      ; ==========================================
    36                                      ; INTERFACE: ENERGIA ATUAL (BARRAS AMARELAS)
    37                                      ; ==========================================
    38                                      
    39                                      ; Vida Atual P1
    40 0000002F 803E[0000]00                CMP byte [p1_hp], 0
    41 00000034 741A                        JE hp2_check        ; Se HP for 0, não desenha a barra amarela
    42                                      
    43 00000036 A0[0000]                    MOV AL, [p1_hp]
    44 00000039 30E4                        XOR AH, AH          ; Limpa AH, deixando apenas p1_hp em AX
    45 0000003B BB1400                      MOV BX, 20
    46 0000003E F7E3                        MUL BX              ; AX = HP * 20 (Calcula a largura atual)
    47 00000040 89C6                        MOV SI, AX          ; Largura
    48 00000042 B91400                      MOV CX, 20          ; X = 20
    49 00000045 BA1400                      MOV DX, 20          ; Y = 20
    50 00000048 BF0F00                      MOV DI, 15          ; Altura
    51 0000004B B00E                        MOV AL, 14          ; Cor: Amarelo
    52 0000004D E84A00                      CALL desenha_retangulo
    53                                  
    54                                  hp2_check:
    55                                      ; Vida Atual P2
    56 00000050 803E[0000]00                CMP byte [p2_hp], 0
    57 00000055 741C                        JE draw_players     ; Se HP for 0, pula
    58                                      
    59 00000057 A0[0000]                    MOV AL, [p2_hp]
    60 0000005A 30E4                        XOR AH, AH
    61 0000005C BB1400                      MOV BX, 20
    62 0000005F F7E3                        MUL BX              ; AX = HP * 20
    63 00000061 89C6                        MOV SI, AX          ; Largura
    64 00000063 B96C02                      MOV CX, 620         ; Borda direita máxima da barra
    65 00000066 29C1                        SUB CX, AX          ; Subtrai a largura para a barra "encolher" para a direita
    66 00000068 BA1400                      MOV DX, 20          ; Y = 20
    67 0000006B BF0F00                      MOV DI, 15          ; Altura
    68 0000006E B00E                        MOV AL, 14          ; Cor: Amarelo
    69 00000070 E82700                      CALL desenha_retangulo
    70                                  
    71                                  draw_players:
    72                                      ; ==========================================
    73                                      ; DESENHA OS LUTADORES
    74                                      ; ==========================================
    75                                      
    76                                      ; Desenha P1
    77 00000073 8B0E[0000]                  MOV CX, [p1_x]
    78 00000077 8B16[0000]                  MOV DX, [p1_y]
    79 0000007B BE1400                      MOV SI, 20          ; Largura 20
    80 0000007E BF1400                      MOV DI, 20          ; Altura 20
    81 00000081 B009                        MOV AL, 9           ; Cor: Azul
    82 00000083 E81400                      CALL desenha_retangulo
    83                                      
    84                                      ; Desenha P2
    85 00000086 8B0E[0000]                  MOV CX, [p2_x]
    86 0000008A 8B16[0000]                  MOV DX, [p2_y]
    87 0000008E BE1400                      MOV SI, 20          ; Largura 20
    88 00000091 BF1400                      MOV DI, 20          ; Altura 20
    89 00000094 B004                        MOV AL, 4           ; Cor: Vermelho
    90 00000096 E80100                      CALL desenha_retangulo
    91                                      
    92 00000099 C3                          RET
    93                                  
    94                                  ; ==========================================
    95                                  ; FUNÇÃO: DESENHA RETÂNGULO GENÉRICO
    96                                  ; Parâmetros:
    97                                  ; CX = Posição X Inicial
    98                                  ; DX = Posição Y Inicial
    99                                  ; SI = Largura
   100                                  ; DI = Altura
   101                                  ; AL = Cor (0 a 15)
   102                                  ; ==========================================
   103                                  desenha_retangulo:
   104 0000009A 81FE0000                    CMP SI, 0
   105 0000009E 7428                        JE fim_retangulo
   106 000000A0 81FF0000                    CMP DI, 0
   107 000000A4 7422                        JE fim_retangulo
   108                                  
   109 000000A6 51                          PUSH CX
   110 000000A7 52                          PUSH DX
   111 000000A8 56                          PUSH SI
   112 000000A9 57                          PUSH DI
   113 000000AA 53                          PUSH BX
   114                                      
   115 000000AB 89FB                        MOV BX, DI          ; Passa a altura para o contador BX
   116                                  linha:
   117 000000AD 51                          PUSH CX             ; Salva X inicial da linha
   118 000000AE 53                          PUSH BX             ; Salva a altura restante
   119                                      
   120 000000AF 89F3                        MOV BX, SI          ; Passa a largura para o contador BX
   121                                  coluna:
   122 000000B1 B40C                        MOV AH, 0Ch         ; INT 10h, 0Ch: Escrever pixel gráfico
   123 000000B3 53                          PUSH BX             
   124 000000B4 B700                        MOV BH, 0           
   125 000000B6 CD10                        INT 10h             
   126 000000B8 5B                          POP BX
   127                                      
   128 000000B9 41                          INC CX              ; Avança 1 pixel para a direita
   129 000000BA 4B                          DEC BX
   130 000000BB 75F4                        JNZ coluna          ; Continua até terminar a largura
   131                                      
   132 000000BD 5B                          POP BX              ; Recupera a altura restante
   133 000000BE 59                          POP CX              ; Volta o X para o começo da linha
   134 000000BF 42                          INC DX              ; Desce 1 pixel (Y = Y + 1)
   135 000000C0 4B                          DEC BX
   136 000000C1 75EA                        JNZ linha           ; Continua até terminar a altura
   137                                      
   138 000000C3 5B                          POP BX
   139 000000C4 5F                          POP DI
   140 000000C5 5E                          POP SI
   141 000000C6 5A                          POP DX
   142 000000C7 59                          POP CX
   143                                  fim_retangulo:
   144 000000C8 C3                          RET
   145                                  
   146                                  ; segment data public
   147                                  ;     global desenha_cena
   148                                  ;     extern p1_x, p1_y, p1_estado
   149                                  ;     extern p2_x, p2_y, p2_estado
   150                                  
   151                                  ; segment code
   152                                  ; desenha_cena:
   153                                  ;     ; 1. Limpa a tela pintando o fundo de preto
   154                                  ;     ; (Usamos a rolagem da BIOS, que é muito mais rápida que pintar pixel por pixel)
   155                                  ;     MOV AX, 0600h       ; Função de rolar a janela (AL=0 limpa a tela)
   156                                  ;     MOV BH, 00h         ; Cor do fundo (Preto)
   157                                  ;     MOV CX, 0000h       ; Canto superior esquerdo (X=0, Y=0)
   158                                  ;     MOV DX, 1D4Fh       ; Canto inferior direito (VGA 640x480)
   159                                  ;     INT 10h
   160                                  
   161                                  ;     ; 2. Desenha o Jogador 1 (Azul = 9)
   162                                  ;     MOV CX, [p1_x]
   163                                  ;     MOV DX, [p1_y]
   164                                  ;     MOV AL, 9
   165                                  ;     CALL desenha_quadrado
   166                                      
   167                                  ;     ; 3. Desenha o Jogador 2 (Vermelho = 4)
   168                                  ;     MOV CX, [p2_x]
   169                                  ;     MOV DX, [p2_y]
   170                                  ;     MOV AL, 4
   171                                  ;     CALL desenha_quadrado
   172                                      
   173                                  ;     RET
   174                                  
   175                                  ; ; Função que desenha um bloco 20x20
   176                                  ; desenha_quadrado:
   177                                  ;     PUSH CX
   178                                  ;     PUSH DX
   179                                  ;     PUSH BX
   180                                      
   181                                  ;     MOV BX, 20          ; Altura = 20 pixels
   182                                  ; linha:
   183                                  ;     PUSH CX             ; Salva a coordenada X do início da linha
   184                                  ;     PUSH BX             ; Salva a altura restante
   185                                      
   186                                  ;     MOV BX, 20          ; Largura = 20 pixels
   187                                  ; coluna:
   188                                  ;     MOV AH, 0Ch         ; Função da BIOS de desenhar pixel
   189                                  ;     PUSH BX             ; Salva a largura restante
   190                                  ;     MOV BH, 0           ; Página de vídeo
   191                                  ;     INT 10h             ; Pinta o pixel nas coordenadas CX, DX
   192                                  ;     POP BX
   193                                      
   194                                  ;     INC CX              ; Anda 1 pixel para a direita
   195                                  ;     DEC BX
   196                                  ;     JNZ coluna          ; Repete até terminar a largura
   197                                      
   198                                  ;     POP BX              ; Recupera a altura restante
   199                                  ;     POP CX              ; Volta a coordenada X para o início da coluna
   200                                  ;     INC DX              ; Desce 1 pixel (próxima linha)
   201                                  ;     DEC BX
   202                                  ;     JNZ linha           ; Repete até terminar a altura
   203                                      
   204                                  ;     POP BX
   205                                  ;     POP DX
   206                                  ;     POP CX
   207                                  ;     RET
   208                                  
   209                                  ;; =========================================== ;;
   210                                  
   211                                  ; segment data public
   212                                  ;     global desenha_cena
   213                                  ;     extern p1_x, p1_y, p1_estado
   214                                  ;     extern p2_x, p2_y, p2_estado
   215                                  
   216                                  ; segment code
   217                                  ; desenha_cena:
   218                                  ;     ; (Aqui você pode incluir uma macro para limpar a tela desenhando um retângulo preto de 640x480)
   219                                      
   220                                  ;     ; Desenha P1
   221                                  ;     MOV CX, [p1_x]
   222                                  ;     MOV DX, [p1_y]
   223                                  ;     MOV AL, 9           ; Cor Azul para P1
   224                                  ;     CALL desenha_lutador_placeholder
   225                                      
   226                                  ;     ; Desenha P2
   227                                  ;     MOV CX, [p2_x]
   228                                  ;     MOV DX, [p2_y]
   229                                  ;     MOV AL, 4           ; Cor Vermelha para P2
   230                                  ;     CALL desenha_lutador_placeholder
   231                                      
   232                                  ;     RET
   233                                  
   234                                  ; desenha_lutador_placeholder:
   235                                  ;     ; CX = X, DX = Y, AL = Cor
   236                                  ;     ; Essa função desenharia um retângulo base.
   237                                  ;     ; Se p1_estado == 2 (Agachado), desenha retângulo menor.
   238                                  ;     ; Se p1_estado == 4 (Soco), desenha um braço estendido (uma linha reta).
   239                                      
   240                                  ;     ; Exemplo de Ponto (Use plot_xy do lab05 na versão final[cite: 6])
   241                                  ;     MOV AH, 0Ch
   242                                  ;     MOV BH, 0
   243                                  ;     INT 10h
   244                                  ;     RET
