     1                                  segment data public
     2                                      global key_map
     3                                      global teclado_init
     4                                      global teclado_restore
     5                                      
     6 00000000 00<rept>                    key_map times 128 db 0    ; Array armazenando 1 se a tecla está pressionada, 0 se solta
     7 00000080 0000                        old_int9_off dw 0
     8 00000082 0000                        old_int9_cs  dw 0
     9                                  
    10                                  segment code
    11                                  teclado_init:
    12 00000000 FA                          CLI
    13 00000001 31C0                        XOR AX, AX
    14 00000003 8EC0                        MOV ES, AX
    15 00000005 26A12400                    MOV AX, [ES:09h*4]
    16 00000009 A3[8000]                    MOV [old_int9_off], AX
    17 0000000C 26A12600                    MOV AX, [ES:09h*4+2]
    18 00000010 A3[8200]                    MOV [old_int9_cs], AX
    19 00000013 268C0E2600                  MOV [ES:09h*4+2], CS
    20 00000018 26C7062400[3600]            MOV WORD [ES:09h*4], int9_handler
    21 0000001F FB                          STI
    22 00000020 C3                          RET
    23                                  
    24                                  teclado_restore:
    25 00000021 FA                          CLI
    26 00000022 31C0                        XOR AX, AX
    27 00000024 8EC0                        MOV ES, AX
    28 00000026 A1[8200]                    MOV AX, [old_int9_cs]
    29 00000029 26A32600                    MOV [ES:09h*4+2], AX
    30 0000002D A1[8000]                    MOV AX, [old_int9_off]
    31 00000030 26A32400                    MOV [ES:09h*4], AX
    32 00000034 FB                          STI
    33 00000035 C3                          RET
    34                                  
    35                                  int9_handler:
    36 00000036 50                          PUSH AX
    37 00000037 53                          PUSH BX
    38 00000038 1E                          PUSH DS
    39 00000039 B8[0000]                    MOV AX, data
    40 0000003C 8ED8                        MOV DS, AX
    41                                  
    42 0000003E E460                        IN AL, 60h              ; Lê o código Make/Break
    43 00000040 88C4                        MOV AH, AL
    44 00000042 247F                        AND AL, 7Fh             ; Isola o código da tecla (0-127)
    45 00000044 31DB                        XOR BX, BX
    46 00000046 88C3                        MOV BL, AL
    47                                  
    48 00000048 F6C480                      TEST AH, 80h            ; Verifica se é Break (tecla solta)
    49 0000004B 7508                        JNZ tecla_solta
    50 0000004D C687[0000]01                MOV byte [key_map + BX], 1  ; Make: Tecla pressionada
    51 00000052 E90500                      JMP finaliza_int9
    52                                  
    53                                  tecla_solta:
    54 00000055 C687[0000]00                MOV byte [key_map + BX], 0  ; Break: Tecla solta
    55                                  
    56                                  finaliza_int9:
    57 0000005A E461                        IN AL, 61h
    58 0000005C 0C80                        OR AL, 80h
    59 0000005E E661                        OUT 61h, AL
    60 00000060 247F                        AND AL, 7Fh
    61 00000062 E661                        OUT 61h, AL
    62 00000064 B020                        MOV AL, 20h
    63 00000066 E620                        OUT 20h, AL
    64 00000068 1F                          POP DS
    65 00000069 5B                          POP BX
    66 0000006A 58                          POP AX
    67 0000006B CF                          IRET
