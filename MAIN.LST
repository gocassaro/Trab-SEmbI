     1                                  segment data public
     2                                      extern teclado_init, teclado_restore, timer_init, timer_restore
     3                                      extern frame_flag, atualiza_mecanica, desenha_cena, key_map, desenha_fundo
     4 00000000 00                          modo_anterior db 0
     5 00000001 00                          estado_jogo   db 0  ; 0=Menu, 1=Jogando, 2=Pause, 3=Game Over
     6                                  
     7                                  segment code
     8                                  ..start:
     9 00000000 B8[0000]                    MOV AX, data
    10 00000003 8ED8                        MOV DS, AX
    11                                      
    12                                      ; Salva modo de vídeo e entra no modo Gráfico VGA 640x480[cite: 8]
    13 00000005 B40F                        MOV AH, 0Fh
    14 00000007 CD10                        INT 10h
    15 00000009 A2[0000]                    MOV [modo_anterior], AL
    16 0000000C B81200                      MOV AX, 0012h
    17 0000000F CD10                        INT 10h
    18                                  
    19 00000011 E8(0000)                    CALL teclado_init
    20 00000014 E8(0000)                    CALL timer_init
    21 00000017 E8(0000)                    CALL desenha_fundo
    22                                  
    23                                  game_loop:
    24                                      ; Pause (Tecla P = 19h)[cite: 5]
    25 0000001A 803E[1000]01                CMP byte [key_map + 10h], 1
    26 0000001F 7431                        JE sair_jogo
    27                                  
    28 00000021 803E[0000]01                CMP byte [frame_flag], 1
    29 00000026 75F2                        JNE game_loop
    30 00000028 C606[0000]00                MOV byte [frame_flag], 0
    31                                  
    32 0000002D E8(0000)                    CALL atualiza_mecanica
    33 00000030 E8(0000)                    CALL desenha_cena       ; Agora ele atualiza apenas os pixels necessários
    34                                  
    35 00000033 E9E4FF                      JMP game_loop
    36                                      
    37                                  verifica_quit:
    38                                      ; Quit (Tecla Q = 10h)[cite: 4]
    39 00000036 803E[1000]01                CMP byte [key_map + 10h], 1
    40 0000003B 7415                        JE sair_jogo
    41                                  
    42                                      ; Sincronização de FPS (só roda a lógica se a INT 8h sinalizou)
    43 0000003D 803E[0000]01                CMP byte [frame_flag], 1
    44 00000042 75D6                        JNE game_loop
    45 00000044 C606[0000]00                MOV byte [frame_flag], 0
    46                                  
    47 00000049 E8(0000)                    CALL atualiza_mecanica
    48 0000004C E8(0000)                    CALL desenha_cena
    49                                      
    50 0000004F E9C8FF                      JMP game_loop
    51                                  
    52                                  sair_jogo:
    53 00000052 E8(0000)                    CALL timer_restore
    54 00000055 E8(0000)                    CALL teclado_restore
    55                                      
    56                                      ; Restaura modo de vídeo[cite: 9]
    57 00000058 B400                        MOV AH, 00h
    58 0000005A A0[0000]                    MOV AL, [modo_anterior]
    59 0000005D CD10                        INT 10h
    60                                      
    61 0000005F B8004C                      MOV AX, 4C00h
    62 00000062 CD21                        INT 21h
    63                                  
    64                                  segment stack stack
    65 00000000 <res 00000100>              resb 256
    66                                  stacktop:
