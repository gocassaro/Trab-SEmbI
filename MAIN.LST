     1                                  segment data public
     2                                      extern teclado_init, teclado_restore, timer_init, timer_restore
     3                                      extern frame_flag, atualiza_mecanica, desenha_cena, key_map
     4 00000000 00                          modo_anterior db 0
     5 00000001 00                          estado_jogo   db 0  ; 0=Menu, 1=Jogando, 2=Pause, 3=Game Over
     6                                  
     7                                  segment code
     8                                  ..start:
     9 00000000 B8[0000]                    MOV AX, data
    10 00000003 8ED8                        MOV DS, AX
    11                                      
    12                                      ; Salva modo de vídeo e entra no modo Gráfico VGA 640x480[cite: 8]
    13 00000005 B40F                        MOV AH, 0Fh
    14 00000007 CD10                        INT 10h
    15 00000009 A2[0000]                    MOV [modo_anterior], AL
    16 0000000C B81200                      MOV AX, 0012h
    17 0000000F CD10                        INT 10h
    18                                  
    19 00000011 E8(0000)                    CALL teclado_init
    20 00000014 E8(0000)                    CALL timer_init
    21                                  
    22                                  game_loop:
    23                                      ; Pause (Tecla P = 19h)[cite: 5]
    24 00000017 803E[1900]01                CMP byte [key_map + 19h], 1
    25 0000001C 7500                        JNE verifica_quit
    26                                      ; Alterna estado de pause aqui...
    27                                      
    28                                  verifica_quit:
    29                                      ; Quit (Tecla Q = 10h)[cite: 4]
    30 0000001E 803E[1000]01                CMP byte [key_map + 10h], 1
    31 00000023 7415                        JE sair_jogo
    32                                  
    33                                      ; Sincronização de FPS (só roda a lógica se a INT 8h sinalizou)
    34 00000025 803E[0000]01                CMP byte [frame_flag], 1
    35 0000002A 75EB                        JNE game_loop
    36 0000002C C606[0000]00                MOV byte [frame_flag], 0
    37                                  
    38 00000031 E8(0000)                    CALL atualiza_mecanica
    39 00000034 E8(0000)                    CALL desenha_cena
    40                                      
    41 00000037 E9DDFF                      JMP game_loop
    42                                  
    43                                  sair_jogo:
    44 0000003A E8(0000)                    CALL timer_restore
    45 0000003D E8(0000)                    CALL teclado_restore
    46                                      
    47                                      ; Restaura modo de vídeo[cite: 9]
    48 00000040 B400                        MOV AH, 00h
    49 00000042 A0[0000]                    MOV AL, [modo_anterior]
    50 00000045 CD10                        INT 10h
    51                                      
    52 00000047 B8004C                      MOV AX, 4C00h
    53 0000004A CD21                        INT 21h
    54                                  
    55                                  segment stack stack
    56 00000000 <res 00000100>              resb 256
    57                                  stacktop:
